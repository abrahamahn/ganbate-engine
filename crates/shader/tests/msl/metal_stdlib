GANBATE_MATRIX(2, 3)
GANBATE_MATRIX(2, 4)
GANBATE_MATRIX(3, 2)
GANBATE_MATRIX(3, 3)
GANBATE_MATRIX(3, 4)
GANBATE_MATRIX(4, 2)
GANBATE_MATRIX(4, 3)
GANBATE_MATRIX(4, 4)
#undef GANBATE_MATRIX
