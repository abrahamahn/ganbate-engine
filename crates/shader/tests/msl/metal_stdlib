GANBATE_MAKE(uint3)
GANBATE_MAKE(uint4)
GANBATE_MAKE(half2)
GANBATE_MAKE(half3)
GANBATE_MAKE(half4)
#undef GANBATE_MAKE
template <class... A> inline bool2 make_bool2(A... a) { return make<int2>(a...); }
template <class... A> inline bool3 make_bool3(A... a) { return make<int3>(a...); }
template <class... A> inline bool4 make_bool4(A... a) { return make<int4>(a...); }

// Packed three-component vectors: 12 bytes, 4-byte aligned.
template <class T> struct packed3 {
    typedef typename vec_of<T, 3>::type unpacked;
    T x, y, z;
    packed3() = default;
    packed3(unpacked v) : x(v.x), y(v.y), z(v.z) {}
    operator unpacked() const {
        unpacked v;
        v.x = x;
        v.y = y;
        v.z = z;
        return v;
    }
    packed3 &operator=(unpacked v) {
        x = v.x;
        y = v.y;
        z = v.z;
        return *this;
    }
    T operator[](int i) const { return i == 0 ? x : i == 1 ? y : z; }
};
template <class T> struct vec_info<packed3<T>> {
    static constexpr int n = 3;
    typedef T elem;
    static constexpr bool vector = true;
};
typedef packed3<float> packed_float3;
typedef packed3<int> packed_int3;
typedef packed3<uint> packed_uint3;
static_assert(sizeof(packed_float3) == 12 && alignof(packed_float3) == 4, "packed_float3");
inline packed_float3 make_packed_float3(float3 v) { return packed_float3(v); }
inline packed_int3 make_packed_int3(int3 v) { return packed_int3(v); }
inline packed_uint3 make_packed_uint3(uint3 v) { return packed_uint3(v); }

// Column-major float matrices: C columns of floatR.
template <int C, int R> struct matrix {
    typedef typename vec_of<float, R>::type column;
    column columns[C];
    matrix() = default;
    template <class... A> explicit matrix(A... a) : columns{a...} {
        static_assert(sizeof...(A) == C, "matrix constructor takes one vector per column");
        static_assert(count((std::is_same<A, column>::value ? 1 : 0)...) == C,
                      "matrix columns have the wrong type");
    }
    column &operator[](int i) { return columns[i]; }
    const column &operator[](int i) const { return columns[i]; }
    column &operator[](uint i) { return columns[i]; }
    const column &operator[](uint i) const { return columns[i]; }
};
#define GANBATE_MATRIX(C, R) typedef matrix<C, R> float##C##x##R;
