constexpr int count() { return 0; }
template <class... R> constexpr int count(int a, R... r) { return a + count(r...); }

template <class E, class A> inline void put(E *out, int &i, A a, std::false_type) {
    static_assert(std::is_arithmetic<A>::value, "vector constructor argument is not a number");
    out[i++] = (E)a;
}
template <class E, class A> inline void put(E *out, int &i, A a, std::true_type) {
    for (int k = 0; k < vec_info<A>::n; ++k)
        out[i++] = (E)a[k];
}

// `metal::floatN(...)`: scalars and vectors whose components add up to N, one scalar
// (broadcast) or one vector of N components of another type (conversion).
template <class V, class... A> inline V make(A... a) {
    typedef typename vec_info<V>::elem E;
    constexpr int n = vec_info<V>::n;
    constexpr int total = count(vec_info<A>::n...);
    static_assert(total == n || (sizeof...(A) == 1 && total == 1),
                  "vector constructor with the wrong number of components");
    E c[4] = {};
    int i = 0;
    int unused[] = {0, (put<E>(c, i, a, std::integral_constant<bool, vec_info<A>::vector>()), 0)...};
    (void)unused;
    V r;
    for (int k = 0; k < n; ++k)
        r[k] = total == 1 ? c[0] : c[k];
    return r;
}
#define GANBATE_MAKE(name)                                                                             \
    template <class... A> inline name make_##name(A... a) { return make<name>(a...); }
GANBATE_MAKE(float2)
GANBATE_MAKE(float3)
