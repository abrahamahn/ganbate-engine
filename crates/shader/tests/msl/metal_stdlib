template <class T, class F> inline T as_type(F f) {
    static_assert(sizeof(T) == sizeof(F), "as_type between types of different sizes");
    return __builtin_bit_cast(T, f);
}

// Built-in functions. T is a float scalar or vector unless noted.
template <class T> struct is_float_type {
    static constexpr bool value = std::is_same<typename vec_info<T>::elem, float>::value;
};
template <class T> struct is_int_type {
    typedef typename vec_info<T>::elem E;
    static constexpr bool value = std::is_same<E, int>::value || std::is_same<E, uint>::value;
};
