{
  "components": {
    "camera": {
      "doc": "A viewpoint: the scene's views, a game's camera profiles, a sequence's shots. It looks along its transform's -Z with +Y up.",
      "fields": {
        "focus": {
          "doc": "Depth of field: nothing nearer than distance blurs; past it the image softens to its full blur, depth metres further on.",
          "fields": {
            "blur": {
              "default": 0.006,
              "doc": "Full blur as a share of the image height (capped at 24 pixels).",
              "labels": {
                "ko": "흐림"
              },
              "max": 0.1,
              "min": 0,
              "type": "float"
            },
            "depth": {
              "default": 4,
              "labels": {
                "ko": "깊이"
              },
              "min": 0,
              "type": "float",
              "unit": "m"
            },
            "distance": {
              "default": 0,
              "labels": {
                "ko": "거리"
              },
              "min": 0,
              "type": "float",
              "unit": "m"
            },
            "enabled": {
              "labels": {
                "ko": "사용"
              },
              "type": "bool"
            }
          },
          "labels": {
            "ko": "초점(피사계 심도)"
          },
          "type": "object"
        },
        "fov": {
          "default": 50,
          "doc": "Vertical field of view.",
          "labels": {
            "ko": "시야각"
          },
          "max": 170,
          "min": 1,
          "type": "float",
          "unit": "deg"
        },
        "near": {
          "default": 0.08,
          "labels": {
            "ko": "가까운 면"
          },
          "min": 0.0001,
          "type": "float",
          "unit": "m"
        },
        "shift": {
          "doc": "Where the target lands in the image, in half-viewports with y up: frames a subject around an interface without turning.",
          "labels": {
            "ko": "렌즈 이동"
          },
          "type": "vec2"
        }
      },
      "label": "Camera",
      "labels": {
        "ko": "카메라"
      }
    },
    "collider": {
      "doc": "The entity's collision shape, in its own frame and scaled with it. Without a rigid_body on the entity it is part of the nearest body above it and moves with it, or, with no body above it, is static scenery. hull and mesh use the entity's own mesh geometry; mesh only on a static body or as scenery.",
      "fields": {
        "center": {
          "doc": "Offset from the entity's origin.",
          "labels": {
            "ko": "중심"
          },
          "type": "vec3",
          "unit": "m"
        },
        "density": {
          "default": 1000,
          "doc": "Mass per volume (water is 1000).",
          "labels": {
            "ko": "밀도"
          },
          "min": 0,
          "type": "float",
          "unit": "kg/m³"
        },
        "friction": {
          "default": 0.6,
          "labels": {
            "ko": "마찰"
          },
          "min": 0,
          "type": "float"
        },
        "half_extents": {
          "default": [0.5, 0.5, 0.5],
          "doc": "Box half size.",
          "labels": {
            "ko": "반 크기"
          },
          "type": "vec3",
          "unit": "m"
        },
        "half_height": {
          "default": 0.5,
          "doc": "Half the length of a capsule's straight part, along its Y axis.",
          "labels": {
            "ko": "반 높이"
          },
          "min": 0,
          "type": "float",
          "unit": "m"
        },
        "layers": {
          "default": 1,
          "doc": "Bits of the layers this collider is on.",
          "labels": {
            "ko": "레이어"
          },
          "max": 4294967295,
          "min": 0,
          "type": "int"
        },
        "mask": {
          "default": 4294967295,
          "doc": "Bits of the layers it collides with.",
          "labels": {
            "ko": "충돌 대상"
          },
          "max": 4294967295,
          "min": 0,
          "type": "int"
        },
        "radius": {
          "default": 0.5,
          "doc": "Sphere and capsule radius.",
          "labels": {
            "ko": "반지름"
          },
          "min": 0.0001,
          "type": "float",
          "unit": "m"
        },
        "restitution": {
          "default": 0,
          "doc": "Bounciness: 0 stops dead, 1 bounces back to the same height.",
          "labels": {
            "ko": "탄성"
          },
          "max": 1,
          "min": 0,
          "type": "float"
        },
        "rotation": {
          "doc": "Turn relative to the entity.",
          "labels": {
            "ko": "회전"
          },
          "type": "quat"
        },
        "sensor": {
          "doc": "Reports what enters and leaves without colliding.",
          "labels": {
            "ko": "감지 영역"
          },
          "type": "bool"
        },
        "shape": {
          "doc": "box, sphere and capsule take their sizes from these fields; hull and mesh take the entity's own mesh. mesh only on a static body or as scenery: moving bodies use hull.",
          "labels": {
            "ko": "모양"
          },
          "type": "enum",
          "values": [
            "box",
            "sphere",
            "capsule",
            "hull",
            "mesh"
          ]
        }
      },
      "label": "Collider",
      "labels": {
        "ko": "충돌체"
      }
    },
    "environment": {
      "doc": "The scene's time, weather and Look. One per scene, usually on its root.",
      "fields": {
        "look": {
          "doc": "The Look file that styles the scene.",
          "kind": "look",
          "labels": {
            "ko": "룩"
          },
          "type": "asset"
        },
        "time": {
          "default": 12,
          "labels": {
            "ko": "시각"
          },
          "max": 24,
          "min": 0,
          "type": "float",
          "unit": "h"
        },
        "weather": {
          "labels": {
            "ko": "날씨"
          },
          "type": "enum",
          "values": [
            "clear",
            "cloudy",
            "overcast",
            "mist",
            "rain",
            "storm",
            "petals"
          ]
        }
      },
      "label": "Environment",
      "labels": {
        "ko": "환경"
      }
    },
    "light": {
      "doc": "A point or spot lamp, shaded like the world's lamps.",
      "fields": {
        "color": {
          "labels": {
            "ko": "색"
          },
          "type": "rgb"
        },
        "follows_lamps": {
          "doc": "Lit only as the evening lights the lamps.",
          "labels": {
            "ko": "저녁에 켜짐"
          },
          "type": "bool"
        },
        "inner": {
          "default": 20,
          "doc": "A spot is at full strength within this angle of its axis (-Z).",
          "labels": {
            "ko": "안쪽 각도"
          },
          "max": 89,
          "min": 0,
          "type": "float",
          "unit": "deg"
        },
        "intensity": {
          "default": 1,
          "labels": {
            "ko": "세기"
          },
          "min": 0,
          "type": "float"
        },
        "kind": {
          "labels": {
            "ko": "종류"
          },
          "type": "enum",
          "values": [
            "point",
            "spot"
          ]
        },
        "outer": {
          "default": 35,
          "doc": "A spot fades to nothing at this angle.",
          "labels": {
            "ko": "바깥 각도"
          },
          "max": 89,
          "min": 0,
          "type": "float",
          "unit": "deg"
        },
        "range": {
          "default": 6,
          "doc": "How far the light reaches; 0 is unlimited.",
          "labels": {
            "ko": "범위"
          },
          "min": 0,
          "type": "float",
          "unit": "m"
        },
        "shadow": {
          "doc": "How much of a spot's light the props' shadows take (0: no shadow).",
          "labels": {
            "ko": "그림자"
          },
          "max": 1,
          "min": 0,
          "type": "float"
        }
      },
      "label": "Light",
      "labels": {
        "ko": "조명"
      }
    },
    "mesh": {
      "doc": "Geometry from a model asset: one node's mesh, or the whole model when node is empty.",
      "fields": {
        "model": {
          "kind": "model",
          "labels": {
            "ko": "모델"
          },
          "type": "asset"
        },
        "node": {
          "doc": "The model node whose mesh this entity draws.",
          "labels": {
            "ko": "노드"
          },
          "type": "string"
        },
        "static": {
          "default": true,
          "doc": "Cooked into the world (lit, shadowed and mapped like the land); otherwise drawn as a prop the game can move.",
          "labels": {
            "ko": "월드에 굽기"
          },
          "type": "bool"
        }
      },
      "label": "Mesh",
      "labels": {
        "ko": "메시"
      }
    },
    "rigid_body": {
      "doc": "Makes the entity a physics body. A descendant without a rigid_body of its own is part of the nearest body above it: its collider adds to that body's shape, and its meshes and lights move with it. A collider with no body above it is static scenery.",
      "fields": {
        "angular_damping": {
          "default": 0.05,
          "labels": {
            "ko": "회전 감쇠"
          },
          "min": 0,
          "type": "float"
        },
        "angular_velocity": {
          "doc": "Starting spin.",
          "labels": {
            "ko": "회전 속도"
          },
          "type": "vec3",
          "unit": "rad/s"
        },
        "bullet": {
          "doc": "Swept against static geometry every step, so even a fast small body cannot pass through walls.",
          "labels": {
            "ko": "총알(연속 충돌)"
          },
          "type": "bool"
        },
        "gravity_scale": {
          "default": 1,
          "labels": {
            "ko": "중력 배율"
          },
          "type": "float"
        },
        "kind": {
          "doc": "dynamic: moved by gravity, contacts and joints; kinematic: moved only by its velocity or by the game; static: never moves.",
          "labels": {
            "ko": "종류"
          },
          "type": "enum",
          "values": [
            "dynamic",
            "kinematic",
            "static"
          ]
        },
        "linear_damping": {
          "default": 0,
          "labels": {
            "ko": "이동 감쇠"
          },
          "min": 0,
          "type": "float"
        },
        "lock_rotation": {
          "doc": "World axes the body may not turn about.",
          "fields": {
            "x": {
              "labels": {
                "ko": "X"
              },
              "type": "bool"
            },
            "y": {
              "labels": {
                "ko": "Y"
              },
              "type": "bool"
            },
            "z": {
              "labels": {
                "ko": "Z"
              },
              "type": "bool"
            }
          },
          "labels": {
            "ko": "회전 잠금"
          },
          "type": "object"
        },
        "lock_translation": {
          "doc": "World axes the body may not move along.",
          "fields": {
            "x": {
              "labels": {
                "ko": "X"
              },
              "type": "bool"
            },
            "y": {
              "labels": {
                "ko": "Y"
              },
              "type": "bool"
            },
            "z": {
              "labels": {
                "ko": "Z"
              },
              "type": "bool"
            }
          },
          "labels": {
            "ko": "이동 잠금"
          },
          "type": "object"
        },
        "never_sleeps": {
          "doc": "Keeps simulating even when still.",
          "labels": {
            "ko": "잠들지 않음"
          },
          "type": "bool"
        },
        "velocity": {
          "doc": "Starting velocity.",
          "labels": {
            "ko": "속도"
          },
          "type": "vec3",
          "unit": "m/s"
        }
      },
      "label": "Rigid body",
      "labels": {
        "ko": "강체"
      }
    },
    "transform": {
      "doc": "Where the entity is, relative to its parent.",
      "fields": {
        "rotation": {
          "labels": {
            "ko": "회전"
          },
          "type": "quat"
        },
        "scale": {
          "default": [1, 1, 1],
          "labels": {
            "ko": "크기"
          },
          "type": "vec3"
        },
        "translation": {
          "labels": {
            "ko": "위치"
          },
          "type": "vec3",
          "unit": "m"
        }
      },
      "label": "Transform",
      "labels": {
        "ko": "변환"
      }
    }
  },
  "ganbate": "schema",
  "version": 1
}
