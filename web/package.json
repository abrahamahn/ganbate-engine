{
  "name": "@ganbate/engine-web",
  "version": "0.2.0",
  "private": true,
  "description": "Ganbate Engine browser WASM runtime SDK and React + TypeScript WebGPU/WebGL 2 scene player.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ganbate.d.ts",
      "import": "./dist/ganbate.js"
    },
    "./character-customization": {
      "types": "./dist/character-customization.d.mts",
      "import": "./dist/character-customization.mjs"
    },
    "./graph-session": {
      "types": "./dist/graph-session.d.mts",
      "import": "./dist/graph-session.mjs"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build": "npm run build:sdk && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:sdk && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
